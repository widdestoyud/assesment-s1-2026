{
  "name": "membership-benefit-card",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_ENV=development vite",
    "dev:tunnel": "cross-env NODE_ENV=development sh -c 'trap \"kill 0\" EXIT; vite & sleep 3 && ngrok http https://localhost:3000 --host-header=localhost:3000 --verify-upstream-tls=false; wait'",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "preview:tunnel": "npm run build && sh -c 'trap \"kill 0\" EXIT; vite preview --port 4173 & sleep 2 && ngrok http 4173; wait'",
    "test": "cross-env NODE_ENV=development vitest --run",
    "test:staged": "cross-env NODE_ENV=development vitest related --run",
    "test:watch": "cross-env NODE_ENV=development vitest --watch",
    "test:coverage": "vitest run --coverage --silent=true --allowOnly=true",
    "prepare": "husky",
    "lint": "eslint . --ext ts,tsx,js,jsx",
    "commit": "npx cz"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.1.1",
    "@tanstack/react-router": "^1.117.1",
    "@types/node": "^20.19.9",
    "awilix": "^12.0.5",
    "buffer": "^6.0.3",
    "crypto-browserify": "^3.12.1",
    "i18next": "^25.0.1",
    "i18next-browser-languagedetector": "^8.0.5",
    "react": "^19.0.0",
    "react-device-detect": "^2.2.3",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.56.1",
    "react-error-boundary": "^5.0.0",
    "react-i18next": "^15.5.1",
    "zod": "^3.25.64"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^9.22.0",
    "@tailwindcss/postcss": "^4.1.5",
    "@tailwindcss/vite": "^4.1.11",
    "@tanstack/react-router-devtools": "^1.117.1",
    "@tanstack/router-cli": "^1.117.1",
    "@tanstack/router-plugin": "^1.117.2",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "autoprefixer": "^10.4.21",
    "commitizen": "^4.3.1",
    "cross-env": "^7.0.3",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.2",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "fast-check": "^4.7.0",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "lint-staged": "^15.5.2",
    "pdf-parse": "^2.4.5",
    "postcss": "^8.5.3",
    "postcss-import": "^16.1.0",
    "prettier": "^3.5.3",
    "stylelint": "^16.21.1",
    "stylelint-config-prettier-scss": "^1.0.0",
    "stylelint-config-standard-scss": "^15.0.1",
    "stylelint-prettier": "^5.0.3",
    "tailwindcss": "^4.1.5",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.26.1",
    "vite": "^6.3.1",
    "vite-plugin-mkcert": "^1.17.8",
    "vite-plugin-node-polyfills": "^0.23.0",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "^3.2.4"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write",
      "npm run test:staged"
    ],
    "*.{css,scss}": [
      "stylelint --fix",
      "prettier --write"
    ],
    "*.{html,json,md}": [
      "prettier --write"
    ]
  },
  "overrides": {
    "commitizen": {
      "lodash": "^4.17.24",
      "inquirer": {
        "external-editor": {
          "tmp": "^0.2.4"
        }
      }
    }
  }
}
